# Copie para .env (ou cole em "Environment variables" no Portainer). Nunca coloque chaves reais no repositório.

# Supabase (Project Settings → API). A ANON é pública; a SERVICE_ROLE é secreta e fica só aqui.
SUPABASE_URL=https://vnvfluimpqvxbvdbmwqa.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Opcional: só se o seu projeto usar a chave JWT antiga (HS256). Sem ela o servidor confere pelo Supabase.
SUPABASE_JWT_SECRET=

# Chave mestra que criptografa as chaves dos usuários (32 bytes em base64). Gere UMA vez e guarde bem:
#   python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
# Se perder ou trocar, as chaves salvas no painel deixam de abrir (cada usuário cola de novo).
APP_ENCRYPTION_KEY=

# Endereço público do painel (igual ao configurado no Supabase como Site URL / Redirect URL)
PUBLIC_BASE_URL=http://localhost:8080
PORT=8080

# RPC público da Solana usado pelo monitor compartilhado
SOLANA_RPC_PUBLIC=https://api.mainnet-beta.solana.com

# Trava geral do modo real: enquanto false, NINGUÉM consegue ligar a execução real no painel.
PUMP_REAL_ALLOWED=false

# Padrões PUMP_* (opcionais; valem para quem ainda não mudou no próprio painel). Exemplos:
# PUMP_COPY_SOL=0.1
# PUMP_SIM_BALANCE_SOL=5
# PUMP_STOP_PCT=40
# PUMP_TOP_N=10
# PUMP_MIN_WINRATE=50
# PUMP_LB_MIN_TRADES=1000
